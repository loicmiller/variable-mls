# RPC credentials of a Bitcoin Core node, used only when the node's cookie cannot be read.
# Copy to ~/.config/vmls/rpc.env and make it readable by you only:
#   mkdir -p ~/.config/vmls && cp rpc.env.example ~/.config/vmls/rpc.env && chmod 600 ~/.config/vmls/rpc.env
# The variables of the same names in the environment are read last.
VMLS_RPC_USER=
VMLS_RPC_PASSWORD=
